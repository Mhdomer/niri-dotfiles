    window-rule {
        geometry-corner-radius 12 // Set every window radius to 20
        clip-to-geometry true
    }

    layer-rule {
        match namespace="^noctalia-wallpaper*"
        place-within-backdrop true
    }

    window-rule {
        match app-id=r#"^org\.gnome\."#
        match app-id="Alacritty"
        match app-id="zen"
        match app-id="com.mitchellh.ghostty"
        match app-id="kitty"
        draw-border-with-background true
    }

    window-rule {
        match app-id="kitty" is-focused=false
        opacity 0.82
    }

    window-rule {
        match app-id="^org.telegram.desktop$" title="^Media viewer$"
        open-fullscreen false
    }

    window-rule {
        match app-id=r#"^com\.github\.hluk\.copyq$"#
        open-floating true
        default-column-width { fixed 420; }
        default-window-height { fixed 600; }
    }

    window-rule {
        match app-id=r#"^org\.kde\.polkit"#
        open-floating true
    }

    window-rule {
        match app-id="disktree"
        open-floating true
        default-column-width { fixed 1300; }
        default-window-height { fixed 850; }
    }

    // Floating Picture-in-Picture for video popouts (Helium, Firefox, Zen, Chrome)
    window-rule {
        match title=r#"(?i)picture[- ]in[- ]picture"#
        open-floating true
        default-column-width { fixed 480; }
        default-window-height { fixed 270; }
    }