    window-rule {
        geometry-corner-radius 12 // Set every window radius to 20
        clip-to-geometry true
    }

    layer-rule {
        match namespace="^noctalia-wallpaper*"
        place-within-backdrop true
    }

    window-rule {
        match app-id=r#"^org\.gnome\."#
        match app-id="Alacritty"
        match app-id="zen"
        match app-id="com.mitchellh.ghostty"
        match app-id="kitty"
        draw-border-with-background true
    }

    window-rule {
        match is-focused=false
        opacity 0.82
    }

    window-rule {
        match app-id="^org.telegram.desktop$" title="^Media viewer$"
        open-fullscreen false
    }

    window-rule {
        match app-id=r#"^com\.github\.hluk\.copyq$"#
        open-floating true
        default-column-width { fixed 420; }
        default-window-height { fixed 600; }
    }

    // Floating Picture-in-Picture for video players
    window-rule {
        match title="^Picture-in-Picture$"
        match title="^Picture in picture$"
        open-floating true
        default-column-width { fixed 480; }
        default-window-height { fixed 270; }
    }

    // Floating File Choosers and Auth Dialogs
    window-rule {
        match title="^(Open|Save|Choose) (File|Folder).*$"
        match app-id=r#"^(org\.kde\.polkit|org\.freedesktop\.impl\.portal)"#
        open-floating true
    }

    // Screencast Privacy Shield (DevSecOps)
    window-rule {
        match app-id=r#"^(org\.keepassxc\.KeePassXC|bitwarden|1Password)$"#
        block-out-from "screencast"
    }