#!/usr/bin/env bash
set -eo pipefail

export WEBKIT_DISABLE_DMABUF_RENDERER=1
APP_BIN="$HOME/.local/bin/handy-app/Handy.AppImage"

send_handy_cmd() {
    local cmd="$1"
    if busctl --user status com.pais.handy.SingleInstance >/dev/null 2>&1; then
        gdbus call --session --dest com.pais.handy.SingleInstance \
            --object-path /com/pais/handy/SingleInstance \
            --method org.SingleInstance.DBus.ExecuteCallback "['$cmd']" "" >/dev/null 2>&1
    else
        "$APP_BIN" "$cmd" >/dev/null 2>&1
    fi
}

ensure_daemon() {
    if ! busctl --user status com.pais.handy.SingleInstance >/dev/null 2>&1 && ! pgrep -x handy >/dev/null 2>&1; then
        nohup env WEBKIT_DISABLE_DMABUF_RENDERER=1 "$APP_BIN" --start-hidden >/dev/null 2>&1 &
        for _ in {1..20}; do
            if busctl --user status com.pais.handy.SingleInstance >/dev/null 2>&1; then
                break
            fi
            sleep 0.1
        done
    fi
}

if [[ "$1" == "--toggle-transcription" ]]; then
    ensure_daemon

    # Check if Handy is currently recording
    if pactl list source-outputs 2>/dev/null | grep -qiE "cpal-pulseaudio|handy"; then
        # Stop recording and transcribe
        send_handy_cmd "--toggle-transcription"

        notify-send -t 1500 -a "Dictation" "Transcribing..." \
            -h string:x-canonical-private-synchronous:handy_dictation \
            -h boolean:suppress-sound:true 2>/dev/null || true
    else
        # Start recording
        send_handy_cmd "--toggle-transcription"

        notify-send -t 1500 -a "Dictation" "Recording..." \
            -h string:x-canonical-private-synchronous:handy_dictation \
            -h boolean:suppress-sound:true 2>/dev/null || true
    fi
    exit 0
fi

# Opening app directly: if already running, show window via DBus
if [[ $# -eq 0 ]]; then
    if busctl --user status com.pais.handy.SingleInstance >/dev/null 2>&1; then
        gdbus call --session --dest com.pais.handy.SingleInstance \
            --object-path /com/pais/handy/SingleInstance \
            --method org.SingleInstance.DBus.ExecuteCallback "[]" "" >/dev/null 2>&1
        exit 0
    fi
fi

exec "$APP_BIN" "$@"
