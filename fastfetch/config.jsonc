{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;137;180;250",
      "title": "38;2;203;166;247",
      "separator": "38;2;147;153;178"
    },
    "key": {
      "width": 13
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#38;2;137;180;250}╭─{#} {#1;38;2;203;166;247}Mohamed@Legion5{#} {#38;2;137;180;250}──────────────────────────────────── ─ □ ✕{#}"
    },
    {
      "type": "title",
      "format": "{#38;2;137;180;250}│{#} {#1;38;2;205;214;244}{user-name}{#}@{host-name}"
    },
    {
      "type": "os",
      "key": "│ os",
      "format": "{pretty-name}"
    },
    {
      "type": "host",
      "key": "│ host",
      "format": "{family} ({name})"
    },
    {
      "type": "kernel",
      "key": "│ kernel",
      "format": "{release}"
    },
    {
      "type": "wm",
      "key": "│ wm"
    },
    {
      "type": "packages",
      "key": "│ pkgs"
    },
    {
      "type": "shell",
      "key": "│ shell"
    },
    {
      "type": "terminal",
      "key": "│ term"
    },
    {
      "type": "cpu",
      "key": "│ cpu",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "│ gpu",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "│ ram",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": "│ disk",
      "folders": "/:/mnt/data",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "type": "display",
      "key": "│ display",
      "compactType": "original-with-mp",
      "format": "{name}: {width}x{height} @ {refresh-rate}Hz"
    },
    {
      "type": "wifi",
      "key": "│ wifi",
      "format": "{ssid} ({signal-quality})"
    },
    {
      "type": "sound",
      "key": "│ audio"
    },
    {
      "type": "localip",
      "key": "│ local ip",
      "showIpv6": false,
      "showMac": false,
      "showLoop": false
    },
    {
      "type": "battery",
      "key": "│ battery"
    },
    {
      "type": "uptime",
      "key": "│ uptime",
      "format": "{?days}{days}d {?}{hours}h {minutes}m"
    },
    {
      "type": "custom",
      "format": "{#38;2;137;180;250}╰──────────────────────────────────────────────────{#}  {#38;2;243;139;168}● {#38;2;250;179;135}● {#38;2;249;226;175}● {#38;2;166;227;161}● {#38;2;137;180;250}● {#38;2;203;166;247}●{#}"
    }
  ]
}
